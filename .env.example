# ── Plex ──────────────────────────────────────────────────────────────────────
# Your Plex server address (LAN IP or hostname).  Never exposed to the browser.
PLEX_URL=http://192.168.1.100:32400

# Obtain from: Plex Web → Settings → Account → Manage → Devices → (any device) → token
# Or visit: https://support.plex.tv/articles/204059436
PLEX_TOKEN=your_plex_token_here

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_APP_ID=your_discord_application_id_here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Space-separated list of origins allowed to call the backend.
# For LAN use: http://<your-server-ip>:3000
ALLOWED_ORIGINS=http://localhost:3000

# ── Internal ──────────────────────────────────────────────────────────────────
# Set automatically by docker-compose; override only if running services manually.
REDIS_URL=redis://redis:6379
BACKEND_URL=http://backend:8000
